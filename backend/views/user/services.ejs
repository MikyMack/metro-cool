    <!-- Our Testimonial Section Start -->
<div class="our-testimonial">
    <div class="container">

        <div class="row section-row align-items-center">
            <div class="col-lg-12">
                <!-- Section Title Start -->
                <div class="section-title section-title-center">
                    <h3 class="wow fadeInUp">Testimonials</h3>
                    <h2 class="text-anime-style-3" data-cursor="-opaque">
                        What Our Customers Say
                    </h2>
                </div>
                <!-- Section Title End -->
            </div>
        </div>

        <div class="row align-items-center">

            <div class="col-lg-8">
                <!-- Testimonial Slider Start -->
                <div class="testimonial-slider">
                    <div class="swiper">
                        <div class="swiper-wrapper" data-cursor-text="Drag">

                            <% if (testimonials && testimonials.length > 0) { %>

                                <% testimonials.forEach((testimonial) => { %>

                                    <div class="swiper-slide">
                                        <div class="testimonial-item">

                                            <div class="testimonial-rating">
                                                <% 
                                                    const rating = testimonial.rating || 5;
                                                    for (let i = 1; i <= 5; i++) {
                                                %>
                                                    <i class="fa-solid fa-star <%= i <= rating ? '' : 'text-muted' %>"></i>
                                                <% } %>
                                            </div>

                                            <div class="testimonial-content">
                                                <p>
                                                    <%= testimonial.content %>
                                                </p>
                                            </div>

                                            <div class="testimonial-body">

                                                <div class="testimonial-author">

                                                    <div class="author-image">
                                                        <figure class="image-anime">

                                                            <% if (testimonial.imageUrl) { %>

                                                                <img
                                                                    src="<%= testimonial.imageUrl %>"
                                                                    alt="<%= testimonial.name %>"
                                                                >

                                                            <% } else { %>

                                                                <img
                                                                    src="images/metrocool/dummy.jpg"
                                                                    alt="<%= testimonial.name %>"
                                                                >

                                                            <% } %>

                                                        </figure>
                                                    </div>

                                                    <div class="author-content">
                                                        <h3>
                                                            <%= testimonial.name %>
                                                        </h3>

                                                        <% if (testimonial.designation) { %>
                                                            <p>
                                                                <%= testimonial.designation %>
                                                            </p>
                                                        <% } %>
                                                    </div>

                                                </div>

                                                <div class="testimonial-quote">
                                                    <img
                                                        src="images/metrocool/google-icon.webp"
                                                        alt="Google"
                                                    >
                                                </div>

                                            </div>

                                        </div>
                                    </div>

                                <% }) %>

                            <% } %>

                        </div>

                        <div class="testimonial-pagination"></div>
                    </div>
                </div>
                <!-- Testimonial Slider End -->
            </div>


         <div class="col-lg-4">

    <!-- Testimonial Counter Box Start -->
    <div class="testimonial-counter-box">

        <div class="testimonial-counter-item">
            <h2>
                <span class="counter">100</span>%
            </h2>
            <p>Customer Satisfaction</p>
        </div>

        <div class="testimonial-counter-item">
            <h2>
                <span class="counter">100</span>%
            </h2>
            <p>Quality Service</p>
        </div>

        <div class="testimonial-counter-item">
            <h2>
                <span class="counter">100</span>%
            </h2>
            <p>Professional Care</p>
        </div>

    </div>
    <!-- Testimonial Counter Box End -->

</div>

        </div>

    </div>
</div>
