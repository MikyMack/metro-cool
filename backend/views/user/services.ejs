<!DOCTYPE html>
<html lang="zxx">
<head>
	<!-- Meta -->
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
	<meta name="description" content="">
	<meta name="keywords" content="">
	<meta name="author" content="Awaiken">
	<!-- Page Title -->
    <title>Metrocool | Services</title>
	<!-- Favicon Icon -->
	<link rel="shortcut icon" type="image/x-icon" href="images/favicon.png">
	<!-- Google Fonts Css-->
	<link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&amp;display=swap" rel="stylesheet">
	<!-- Bootstrap Css -->
	<link href="css/bootstrap.min.css" rel="stylesheet" media="screen">
	<!-- SlickNav Css -->
	<link href="css/slicknav.min.css" rel="stylesheet">
	<!-- Swiper Css -->
	<link rel="stylesheet" href="css/swiper-bundle.min.css">
	<!-- Font Awesome Icon Css-->
	<link href="css/all.min.css" rel="stylesheet" media="screen">
	<!-- Animated Css -->
	<link href="css/animate.css" rel="stylesheet">
    <!-- Magnific Popup Core Css File -->
	<link rel="stylesheet" href="css/magnific-popup.css">
	<!-- Mouse Cursor Css File -->
	<link rel="stylesheet" href="css/mousecursor.css">
	<!-- Main Custom Css -->
	<link href="css/custom.css" rel="stylesheet" media="screen">
</head>
<body>

    <!-- Header Start -->
	<%- include('../partial/header') %>
	<!-- Header End -->

    <!-- Page Header Section Start -->
    <div class="page-header bg-section parallaxie">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Page Header Box Start -->
                    <div class="page-header-box">
                        <h1 class="text-anime-style-3 " data-cursor="-opaque">Services</h1>
                        <nav class="wow fadeInUp " data-wow-delay="0.25s">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">home / Services</a></li>
                       
                            </ol>
                        </nav>
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header Section End -->

    <!-- Our Services Section Start -->
<div class="page-services bg-section">

    <div class="container">

        <div class="row">

            <% if (services && services.length > 0) { %>

                <% services.forEach((service, index) => { %>

                    <!-- Service Item Start -->
                    <div class="col-lg-3 col-md-6">

                        <div
                            class="service-item wow fadeInUp"
                            data-wow-delay="<%= (index % 4) * 0.2 %>s"
                        >

                            <!-- Service Image Start -->
                            <div class="service-image">

                                <a
                                    href="/services/<%= service.slug %>"
                                    data-cursor-text="View"
                                >

                                    <figure class="image-anime">

                                        <%
                                            let serviceImage = "/images/default-service.jpg";

                                            if (
                                                service.images &&
                                                service.images.length > 0 &&
                                                service.images[0]
                                            ) {
                                                serviceImage = service.images[0];

                                                if (!serviceImage.startsWith("/")) {
                                                    serviceImage = "/uploads/" + serviceImage;
                                                }
                                            }
                                        %>

                                        <img
                                            src="<%= serviceImage %>"
                                            alt="<%= service.title %>"
                                        >

                                    </figure>

                                </a>

                            </div>
                            <!-- Service Image End -->


                            <!-- Service Body Start -->
                            <div class="service-body">

                                <div class="service-content">

                                    <h3>
                                        <a href="/services/<%= service.slug %>">
                                            <%= service.title %>
                                        </a>
                                    </h3>

                                </div>


                                <div class="service-btn">

                                    <a
                                        href="/services/<%= service.slug %>"
                                        class="readmore-btn"
                                    >
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>

                                </div>

                            </div>
                            <!-- Service Body End -->

                        </div>

                    </div>
                    <!-- Service Item End -->

                <% }) %>

            <% } else { %>

                <!-- No Services -->
                <div class="col-lg-12">

                    <div class="text-center">

                        <h3>No services available</h3>

                    </div>

                </div>

            <% } %>

        </div>


        <!-- Pagination Start -->

        <% if (totalPages > 1) { %>

            <div class="row">

                <div class="col-lg-12">

                    <div
                        class="page-pagination wow fadeInUp"
                        data-wow-delay="0.8s"
                    >

                        <ul class="pagination">


                            <!-- Previous Button -->

                            <% if (currentPage > 1) { %>

                                <li>
                                    <a href="/services?page=<%= currentPage - 1 %>">
                                        <i class="fa-solid fa-angle-left"></i>
                                    </a>
                                </li>

                            <% } else { %>

                                <li class="disabled">
                                    <a href="javascript:void(0);">
                                        <i class="fa-solid fa-angle-left"></i>
                                    </a>
                                </li>

                            <% } %>


                            <!-- Page Numbers -->

                            <% for (let i = 1; i <= totalPages; i++) { %>

                                <li class="<%= currentPage === i ? 'active' : '' %>">

                                    <a href="/services?page=<%= i %>">
                                        <%= i %>
                                    </a>

                                </li>

                            <% } %>


                            <!-- Next Button -->

                            <% if (currentPage < totalPages) { %>

                                <li>
                                    <a href="/services?page=<%= currentPage + 1 %>">
                                        <i class="fa-solid fa-angle-right"></i>
                                    </a>
                                </li>

                            <% } else { %>

                                <li class="disabled">
                                    <a href="javascript:void(0);">
                                        <i class="fa-solid fa-angle-right"></i>
                                    </a>
                                </li>

                            <% } %>


                        </ul>

                    </div>

                </div>

            </div>

        <% } %>

        <!-- Pagination End -->


    </div>

</div>
    <!-- Our Services Section End -->

    <!-- How It Work Section Start -->
<div class="how-it-work bg-section dark-section">

    <div class="container">

        <div class="row section-row align-items-center">
            <div class="col-lg-12">

                <!-- Section Title Start -->
                <div class="section-title section-title-center">

                    <h3 class="wow fadeInUp">
                        How It Works
                    </h3>

                    <h2 class="text-anime-style-3" data-cursor="-opaque">
                        Simple & Reliable Appliance Service in Four Easy Steps
                    </h2>

                </div>
                <!-- Section Title End -->

            </div>
        </div>


        <div class="row">

            <!-- Step 01 -->
            <div class="col-lg-3 col-md-6">

                <!-- How Work Item Start -->
                <div class="how-work-item wow fadeInUp">

                    <div class="how-work-item-image">

                        <figure class="image-anime">
                            <img src="images/metrocool/step-1.jpg"
                                alt="Book AC or Washing Machine Service">
                        </figure>

                        <div class="how-work-item-no">
                            <h3>01</h3>
                        </div>

                    </div>

                    <div class="how-work-item-content">

                        <h3>
                            Book a Service
                        </h3>

                        <p>
                           Tell us what service you need and choose a convenient time.
Quick booking, convenient scheduling, and hassle-free service.
                        </p>

                    </div>

                </div>
                <!-- How Work Item End -->

            </div>


            <!-- Step 02 -->
            <div class="col-lg-3 col-md-6">

                <!-- How Work Item Start -->
                <div class="how-work-item wow fadeInUp"
                    data-wow-delay="0.2s">

                    <div class="how-work-item-image">

                        <figure class="image-anime">
                            <img src="images/metrocool/step-2.jpg"
                                alt="Appliance Inspection">
                        </figure>

                        <div class="how-work-item-no">
                            <h3>02</h3>
                        </div>

                    </div>

                    <div class="how-work-item-content">

                        <h3>
                            Appliance Inspection
                        </h3>

                        <p>
                            Our technician checks the appliance carefully
                            to identify the issue and determine the required service.
                        </p>

                    </div>

                </div>
                <!-- How Work Item End -->

            </div>


            <!-- Step 03 -->
            <div class="col-lg-3 col-md-6">

                <!-- How Work Item Start -->
                <div class="how-work-item wow fadeInUp"
                    data-wow-delay="0.4s">

                    <div class="how-work-item-image">

                        <figure class="image-anime">
                            <img src="images/metrocool/step-3.jpg"
                                alt="Professional AC and Washing Machine Service">
                        </figure>

                        <div class="how-work-item-no">
                            <h3>03</h3>
                        </div>

                    </div>

                    <div class="how-work-item-content">

                        <h3>
                            Professional Service
                        </h3>

                        <p>
                            We carry out the required cleaning, maintenance
                            or repair using the appropriate tools and techniques.
                        </p>

                    </div>

                </div>
                <!-- How Work Item End -->

            </div>


            <!-- Step 04 -->
            <div class="col-lg-3 col-md-6">

                <!-- How Work Item Start -->
                <div class="how-work-item wow fadeInUp"
                    data-wow-delay="0.6s">

                    <div class="how-work-item-image">

                        <figure class="image-anime">
                            <img src="images/metrocool/step-4.jpg"
                                alt="Completed Appliance Service">
                        </figure>

                        <div class="how-work-item-no">
                            <h3>04</h3>
                        </div>

                    </div>

                    <div class="how-work-item-content">

                        <h3>
                            Service Completed
                        </h3>

                    <p>
    Once the work is complete, we carefully check your appliance
    to ensure everything is working smoothly and reliably.
</p>

                    </div>

                </div>
                <!-- How Work Item End -->

            </div>


            <!-- Section Footer Text Start -->
            <div class="col-lg-12">

                <div class="section-footer-text wow fadeInUp"
                    data-wow-delay="0.8s">

                    <p>
                        Need AC or Washing Machine Service?
                        <a href="/contact">
                            Book Your Service
                        </a>
                    </p>

                </div>

            </div>
            <!-- Section Footer Text End -->

        </div>

    </div>

</div>
    <!-- How It Work Section End -->

   

    <!-- Our Faqs Section Start -->
 <div class="our-faqs bg-section">

    <div class="container">

