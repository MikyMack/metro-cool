<!DOCTYPE html>
<html lang="zxx">
  <head>
    <!-- Meta -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1"
    />
    <meta name="description" content="" />
    <meta name="keywords" content="" />
    <meta name="author" content="Awaiken" />
    <!-- Page Title -->
    <title>Metrocool | Service Details</title>
    <!-- Favicon Icon -->
    <link rel="shortcut icon" type="image/x-icon" href="/images/metrocool/logo.png" />
    <!-- Google Fonts Css-->
    <link rel="preconnect" href="https://fonts.googleapis.com/" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&amp;display=swap"
      rel="stylesheet"
    />
    <!-- Bootstrap Css -->
    <link href="/css/bootstrap.min.css" rel="stylesheet" media="screen" />
    <!-- SlickNav Css -->
    <link href="/css/slicknav.min.css" rel="stylesheet" />
    <!-- Swiper Css -->
    <link rel="stylesheet" href="/css/swiper-bundle.min.css" />
    <!-- Font Awesome Icon Css-->
    <link href="/css/all.min.css" rel="stylesheet" media="screen" />
    <!-- Animated Css -->
    <link href="/css/animate.css" rel="stylesheet" />
    <!-- Magnific Popup Core Css File -->
    <link rel="stylesheet" href="/css/magnific-popup.css" />
    <!-- Mouse Cursor Css File -->
    <link rel="stylesheet" href="/css/mousecursor.css" />
    <!-- Main Custom Css -->
    <link href="/css/custom.css" rel="stylesheet" media="screen" />

    <link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css"
/>
  </head>
  <body>
    
    <!-- Header Start -->
	<%- include('../partial/header') %>
	<!-- Header End -->

    <!-- Page Header Section Start -->
    <div class="page-header bg-section parallaxie">
      <div class="container">
        <div class="row">
          <div class="col-lg-12">
            <!-- Page Header Box Start -->
            <div class="page-header-box">
              <h1 class="text-anime-style-3" data-cursor="-opaque">
                AC Maintance
              </h1>
              <nav class="wow fadeInUp r" data-wow-delay="0.25s">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item">
                    <a href="/">home / Services</a>
                  </li>
                </ol>
              </nav>
            </div>
            <!-- Page Header Box End -->
          </div>
        </div>
      </div>
    </div>
    <!-- Page Header Section End -->

    <!-- Page Service Single Start -->
<div class="page-service-single">
  <div class="container">
    <div class="row">

      <div class="col-lg-4">

        <!-- Page Single Sidebar Start -->
        <div class="page-single-sidebar">

          <!-- Page Category List Start -->
          <div class="page-catagery-list wow fadeInUp">

  <h3>Our Services</h3>

  <ul>
    <% services.forEach((item) => { %>

      <li>
        <a href="/services/<%= item.slug %>">
          <%= item.title %>
        </a>
      </li>

    <% }) %>
  </ul>

</div>
          <!-- Page Category List End -->


          <!-- Sidebar CTA Box Start -->
          <div class="sidebar-cta-box wow fadeInUp" data-wow-delay="0.25s">

            <!-- Sidebar CTA Content Start -->
            <div class="sidebar-cta-content">
              <h3>
                Need appliance care? We're here to help with professional
                service and reliable solutions.
              </h3>
            </div>
            <!-- Sidebar CTA Content End -->


            <!-- Sidebar CTA Contact Start -->
            <div class="sidebar-cta-contact">

              <!-- Sidebar CTA Contact Item Start -->
              <div class="sidebar-cta-contact-item">
                <h3>Call us</h3>

                <p>
                  <a href="tel:+919567566893">
                    +91 95675 66893
                  </a>
                </p>
              </div>
              <!-- Sidebar CTA Contact Item End -->


              <!-- Sidebar CTA Contact Item Start -->
              <div class="sidebar-cta-contact-item">
                <h3>Email us</h3>

                <p>
                  <a href="mailto:info@metrocool.in">
                    info@metrocool.in
                  </a>
                </p>
              </div>
              <!-- Sidebar CTA Contact Item End -->

            </div>
            <!-- Sidebar CTA Contact End -->

          </div>
          <!-- Sidebar CTA Box End -->

        </div>
        <!-- Page Single Sidebar End -->

      </div>


      <div class="col-lg-8">

        <!-- Service Single Content Start -->
        <div class="service-single-content">


          <!-- Service Single Slider Start -->
          <div class="service-single-slider">

            <div class="swiper">

              <div class="swiper-wrapper">

                <% if (service.images && service.images.length > 0) { %>

                  <% service.images.forEach((image, index) => { %>

                    <!-- Swiper Slide Start -->
                    <div class="swiper-slide">

                      <figure class="image-anime">

                        <img
                          src="<%= image %>"
                          alt="<%= service.title %> - Image <%= index + 1 %>"
                        />

                      </figure>

                    </div>
                    <!-- Swiper Slide End -->

                  <% }) %>

                <% } %>

              </div>


              <!-- Service Single Button Start -->
              <div class="service-single-btn">
                <div class="service-button-next"></div>
                <div class="service-button-prev"></div>
              </div>
              <!-- Service Single Button End -->

            </div>

          </div>
          <!-- Service Single Slider End -->


          <!-- Service Entry Start -->
          <div class="service-entry">

            <!-- Dynamic Service Content -->
            <%- service.content %>


            <!-- Service Solution Box Start -->
            <div class="service-solutions-box">

              <h2 class="text-anime-style-3">
                <%= service.title %>
              </h2>

              <% if (service.shortDescription) { %>

                <p class="wow fadeInUp" data-wow-delay="0.2s">
                  <%= service.shortDescription %>
                </p>

              <% } %>


              <% if (service.tags && service.tags.length > 0) { %>

                <ul class="wow fadeInUp" data-wow-delay="0.2s">

                  <% service.tags.forEach((tag) => { %>

                    <li>
                      <%= tag %>
                    </li>

                  <% }) %>

                </ul>

              <% } %>

            </div>
            <!-- Service Solution Box End -->

          </div>
          <!-- Service Entry End -->

          <!-- Service Enquiry CTA Start -->
<div class="service-enquiry-cta">
  <div class="service-enquiry-cta-content">
    <h3>Need this service?</h3>
    <p>
      Get in touch with our team for professional and reliable service.
    </p>
  </div>

  <button
    type="button"
    class="service-enquiry-btn"
    data-bs-toggle="modal"
    data-bs-target="#serviceEnquiryModal"
  >
    Request This Service
    <i class="bi bi-arrow-right"></i>
  </button>
</div>
<!-- Service Enquiry CTA End -->


          <!-- Page Single FAQs Start -->
          <% if (service.faq && service.faq.length > 0) { %>

            <div class="page-single-faqs">

              <!-- Section Title Start -->
              <div class="section-title">

                <h2
                  class="text-anime-style-3"
                  data-cursor="-opaque"
                >
                  Frequently Asked Questions
                </h2>

              </div>
              <!-- Section Title End -->


              <!-- FAQ Accordion Start -->
              <div
                class="faq-accordion page-faq-accordion"
                id="faqaccordion"
              >

                <% service.faq.forEach((faq, index) => { %>

                  <!-- FAQ Item Start -->
                  <div
                    class="accordion-item wow fadeInUp"
                    <% if (index > 0) { %>
                      data-wow-delay="<%= index * 0.2 %>s"
                    <% } %>
                  >

                    <h2
                      class="accordion-header"
                      id="heading<%= index %>"
                    >

                      <button
                        class="accordion-button <%= index === 0 ? '' : 'collapsed' %>"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse<%= index %>"
                        aria-expanded="<%= index === 0 ? 'true' : 'false' %>"
                        aria-controls="collapse<%= index %>"
                      >
                        <%= faq.question %>
                      </button>

                    </h2>


                    <div
                      id="collapse<%= index %>"
                      class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>"
                      aria-labelledby="heading<%= index %>"
                      data-bs-parent="#faqaccordion"
                    >

                      <div class="accordion-body">

                        <p>
                          <%= faq.answer %>
                        </p>

                      </div>

                    </div>

                  </div>
                  <!-- FAQ Item End -->

                <% }) %>

              </div>
              <!-- FAQ Accordion End -->

            </div>

          <% } %>
          <!-- Page Single FAQs End -->


        </div>
        <!-- Service Single Content End -->

      </div>

    </div>
  </div>
</div>
    <!-- Page Service Single End -->

<div
  class="modal fade service-enquiry-modal"
  id="serviceEnquiryModal"
  tabindex="-1"
  aria-labelledby="serviceEnquiryModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <!-- Header -->
      <div class="modal-header">
        <div>
          <span class="service-enquiry-eyebrow">
            Service Request
          </span>

          <h2 class="modal-title" id="serviceEnquiryModalLabel">
            Request This Service
          </h2>
        </div>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>

      <!-- Body -->
      <div class="modal-body">

        <form id="serviceEnquiryForm">

          <input
            type="hidden"
            id="enquiryService"
            value="<%= service._id %>"
          />

          <input
            type="hidden"
            id="enquirySource"
            value="service"
          />

          <div class="enquiry-modal-grid">

            <!-- LEFT -->
            <div class="enquiry-service-info">

              <span class="enquiry-info-label">
                Service
              </span>

              <h3>
                <%= service.title %>
              </h3>

              <p>
                Need professional service? Fill in your details
                and our team will get in touch with you shortly.
              </p>

              <div class="enquiry-info-note">
                <i class="bi bi-check-circle"></i>
                <span>
                  Our team will contact you to understand your
                  requirements and schedule the service.
                </span>
              </div>

            </div>

            <!-- RIGHT -->
            <div class="enquiry-contact-fields">

              <div class="enquiry-form-group">
                <label for="enquiryName">
                  Name <span>*</span>
                </label>

                <input
                  type="text"
                  id="enquiryName"
                  name="name"
                  placeholder="Enter your name"
                  maxlength="100"
                  required
                />
              </div>

              <div class="enquiry-form-group">
                <label for="enquiryPhone">
                  Phone Number <span>*</span>
                </label>

                <input
                  type="tel"
                  id="enquiryPhone"
                  name="phone"
                  placeholder="Enter your phone number"
                  maxlength="20"
                  required
                />
              </div>

              <div class="enquiry-form-group">
                <label for="enquiryEmail">
                  Email <small>(Optional)</small>
                </label>

                <input
                  type="email"
                  id="enquiryEmail"
                  name="email"
                  placeholder="Enter your email address"
                />
              </div>

            </div>

          </div>

          <!-- FULL WIDTH -->
          <div class="enquiry-message-section">

            <div class="enquiry-form-group">
              <label for="enquiryMessage">
                Message <small>(Optional)</small>
              </label>

              <textarea
                id="enquiryMessage"
                name="message"
                rows="4"
                maxlength="500"
                placeholder="Tell us how we can help..."
              ></textarea>
            </div>

          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="enquiry-submit-btn"
            id="serviceEnquirySubmit"
          >
            <span id="serviceEnquirySubmitText">
              Submit Request
            </span>

            <i class="bi bi-arrow-right"></i>
          </button>

        </form>

      </div>

    </div>
  </div>
</div>

    <!-- Footer Start -->
    <%- include('../partial/footer') %>
    <!-- Footer End -->

<!-- Mobile Bottom Navigation Start -->
    <%- include('../partial/bottom-nav') %>
<!-- Mobile Bottom Navigation End -->

<!--  Floating Contact Buttons -->
    <%- include('../partial/floating-icons') %>

    
    <!-- Jquery Library File -->
    <script src="/js/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap js file -->
    <script src="/js/bootstrap.min.js"></script>
    <!-- Validator js file -->
    <script src="/js/validator.min.js"></script>
    <!-- SlickNav js file -->
    <script src="/js/jquery.slicknav.js"></script>
    <!-- Swiper js file -->
    <script src="/js/swiper-bundle.min.js"></script>
    <!-- Counter js file -->
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.counterup.min.js"></script>
    <!-- Isotop js file -->
    <script src="/js/isotope.min.js"></script>
    <!-- Magnific js file -->
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <!-- SmoothScroll -->
    <script src="/js/SmoothScroll.js"></script>
    <!-- Parallax js -->
    <script src="/js/parallaxie.js"></script>
    <!-- MagicCursor js file -->
    <script src="/js/gsap.min.js"></script>
    <script src="/js/magiccursor.js"></script>
    <!-- Text Effect js file -->
    <script src="/js/SplitText.js"></script>
    <script src="/js/ScrollTrigger.min.js"></script>
    <!-- YTPlayer js File -->
    <script src="/js/jquery.mb.YTPlayer.min.js"></script>
    <!-- Wow js file -->
    <script src="/js/wow.min.js"></script>
    <!-- Main Custom js file -->
    <script src="/js/function.js"></script>
    <script
  src="https://cdn.jsdelivr.net/npm/toastify-js"
></script>
<script src="/js/enquiry.js"></script>
    <script src="../../demo.awaikenthemes.com/assets/js/theme-panel-dynamic.js"></script>
  </body>
</html>
