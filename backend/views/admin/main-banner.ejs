<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Main Banner Management | Metro Cool Admin</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/admin-css/admin.css" />

    <!-- font-awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>

  <body>
    <div class="admin-layout">
      <!-- =========================================
         SIDEBAR
    ========================================== -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-inner">
          <!-- Logo -->
          <div class="brand">
            <div class="brand-icon">
              <i class="bi bi-flower1"></i>
            </div>

            <div class="brand-content">
              <h1>Metro Cool</h1>
              <span>Service Listing</span>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="sidebar-nav">
            <a href="/admin/dashboard" class="nav-item">
              <i class="bi bi-house-fill"></i>
              <span>Dashboard</span>
            </a>

            <a href="/admin/services" class="nav-item">
              <i class="bi bi-grid-3x3-gap"></i>
              <span>Services</span>
            </a>

            <a href="/admin/main-banners" class="nav-item active">
              <i class="bi bi-image"></i>
              <span>Main Banners</span>
            </a>

            <a href="/admin/mobile-banners" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Mobile Banners</span>
            </a>

            <a href="/admin/blogs" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Blogs</span>
            </a>

            <a href="/admin/gallery" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Gallery</span>
            </a>

            <a href="/admin/testimonials" class="nav-item">
              <i class="bi bi-chat-square-text"></i>
              <span>Testimonials</span>
            </a>
          </nav>

          <!-- Bottom Section -->
          <div class="sidebar-bottom">
            <a href="/admin/logout" class="logout-link">
              <i class="bi bi-box-arrow-right"></i>
              <span>Logout</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Sidebar overlay for mobile -->
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <!-- =========================================
         MAIN CONTENT
    ========================================== -->
      <main class="main-content">
        <!-- =========================================
         TOP HEADER
    ========================================== -->
        <header class="top-header">
          <div class="header-left">
            <button class="sidebar-toggle" id="sidebarToggle">
              <i class="bi bi-list"></i>
            </button>
          </div>

          <div class="header-right">
            <!-- User -->
            <div class="header-user">
              <div class="header-user-info">
                <strong>Metro Cool</strong>
                <span>Admin</span>
              </div>

              <div class="header-user-avatar">
                <img src="assets/images/user.jpg" alt="Admin" />
              </div>
            </div>
          </div>
        </header>

        <!-- =========================================
         BANNERS CONTENT
    ========================================== -->

        <div class="dashboard-content banners-page">
          <!-- =====================================
             PAGE HEADER
        ====================================== -->

          <div class="banners-page-header">
            <div class="page-title-wrapper">
              <h2>Main Banners</h2>

              <div class="breadcrumb-custom">
                <a href="/admin/dashboard"> Dashboard </a>

                <i class="bi bi-chevron-right"></i>

                <span>Main Banners</span>
              </div>
            </div>

            <!-- Add Banner -->

            <a href="/admin/main-banner-form" class="add-banner-btn">
              <i class="bi bi-plus-lg"></i>

              <span>Add New Banner</span>
            </a>
          </div>

          <!-- =====================================
             FILTER
        ====================================== -->

          <div class="banners-toolbar">
            <div class="banner-filter">
              <select id="bannerStatusFilter">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
              </select>

              <i class="bi bi-chevron-down"></i>
            </div>
          </div>

          <!-- =====================================
             BANNERS GRID
        ====================================== -->

          <div class="row g-3 banners-grid" id="bannersGrid"></div>

          <!-- =====================================
             EMPTY STATE
        ====================================== -->

          <div class="banners-empty" id="bannersEmpty">
            <i class="bi bi-images"></i>

            <h4>No banners found</h4>

            <p>No banners match the selected status.</p>
          </div>

          <!-- =====================================
             PAGINATION
        ====================================== -->

          <div class="services-pagination">
            <button type="button" class="pagination-btn disabled">
              <i class="bi bi-chevron-left"></i>
            </button>

            <button type="button" class="pagination-btn active">1</button>

            <button type="button" class="pagination-btn">2</button>

            <button type="button" class="pagination-btn">3</button>

            <span class="pagination-dots"> ... </span>

            <button type="button" class="pagination-btn">16</button>

            <button type="button" class="pagination-btn">
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>
        </div>
      </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/main-banner.js"></script>
\  </body>
</html>
