<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Add Gallery Image - Metro Cool Admin</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <link rel="stylesheet" href="/admin-css/admin.css" />
  </head>

  <body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-inner">
        <!-- Logo -->
        <div class="brand">
          <div class="brand-icon">
            <i class="bi bi-flower1"></i>
          </div>

          <div class="brand-content">
            <h1>Metro Cool</h1>
            <span>Service Listing</span>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav">
          <a href="/admin/dashboard" class="nav-item">
            <i class="bi bi-house-fill"></i>
            <span>Dashboard</span>
          </a>

          <a href="/admin/services" class="nav-item">
            <i class="bi bi-grid-3x3-gap"></i>
            <span>Services</span>
          </a>

          <a href="/admin/main-banners" class="nav-item">
            <i class="bi bi-image"></i>
            <span>Main Banners</span>
          </a>

          <a href="/admin/mobile-banners" class="nav-item">
            <i class="bi bi-image"></i>
            <span>Mobile Banners</span>
          </a>

          <a href="/admin/blogs" class="nav-item">
            <i class="bi bi-file-earmark-text"></i>
            <span>Blogs</span>
          </a>

          <a href="/admin/gallery" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Gallery</span>
            </a>

          <a href="/admin/testimonials" class="nav-item">
            <i class="bi bi-chat-square-text"></i>
            <span>Testimonials</span>
          </a>
        </nav>

        <!-- Bottom Section -->
        <div class="sidebar-bottom">
          <a href="#" class="logout-link">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Header -->
      <header class="top-header">
        <div class="header-left">
          <button type="button" class="sidebar-toggle" id="sidebarToggle">
            <i class="bi bi-list"></i>
          </button>

          <div class="header-search">
            <i class="bi bi-search"></i>

            <input type="text" placeholder="Search..." />
          </div>
        </div>

        <div class="header-user">
          <div class="header-user-info">
            <strong>Metro Cool</strong>
            <span>Admin</span>
          </div>

          <div class="header-user-avatar">
            <img src="assets/images/user.jpg" alt="Admin" />
          </div>
        </div>
      </header>

      <!-- Content -->
      <div class="dashboard-content">
        <!-- Page Header -->
        <div class="service-form-header">
          <div>
            <h2 id="formPageTitle">Add New Gallery Image</h2>

            <div class="breadcrumb-custom">
              <a href="index.html"> Dashboard </a>

              <i class="bi bi-chevron-right"></i>

              <a href="gallery.html"> Gallery </a>

              <i class="bi bi-chevron-right"></i>

              <span id="breadcrumbCurrent"> Add Gallery Image </span>
            </div>
          </div>

          <a href="/admin/gallery" class="back-btn">
            <i class="bi bi-arrow-left"></i>

            Back to Gallery
          </a>
        </div>

        <!-- Form -->
        <form id="galleryForm" class="banner-form">
          <div class="row g-4">
            <!-- =================================================
         LEFT : GALLERY INFORMATION
    ================================================== -->

            <div class="col-12 col-xl-8">
              <div class="form-card">
                <div class="form-card-header">
                  <div>
                    <h3>Gallery Information</h3>
                    <p>Add the details for this gallery image.</p>
                  </div>
                </div>

                <div class="form-card-body">
                  <!-- Title -->
                  <div class="form-group">
                    <label for="galleryTitle">Title</label>

                    <input
                      type="text"
                      id="galleryTitle"
                      name="title"
                      class="form-control-custom"
                      placeholder="Enter image title"
                    />
                  </div>

                  <!-- Sort Order -->
                  <div class="form-group">
                    <label for="gallerySortOrder">Sort Order</label>

                    <input
                      type="number"
                      id="gallerySortOrder"
                      name="sort_order"
                      class="form-control-custom"
                      placeholder="e.g. 1"
                      min="0"
                      value="0"
                    />
                  </div>

                  <!-- Alt Text -->
                  <div class="form-group">
                    <label for="galleryAltText">Alt Text</label>

                    <input
                      type="text"
                      id="galleryAltText"
                      name="alt_text"
                      class="form-control-custom"
                      placeholder="e.g. AC service technician"
                    />
                  </div>

                  <!-- Status -->
                  <div class="form-group">
                    <label for="galleryStatus">Status</label>

                    <div class="select-wrapper">
                      <select
                        id="galleryStatus"
                        name="status"
                        class="form-control-custom"
                      >
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                      </select>

                      <i class="bi bi-chevron-down"></i>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- =================================================
         RIGHT : IMAGE
    ================================================== -->

            <div class="col-12 col-xl-4">
              <div class="form-card">
                <div class="form-card-header">
                  <div>
                    <h3>Gallery Image</h3>
                    <p>Upload the image for this gallery item.</p>
                  </div>
                </div>

                <div class="form-card-body">
                  <div
                    class="service-image-preview banner-image-preview"
                    id="galleryImagePreview"
                  >
                    <div class="image-placeholder">
                      <i class="bi bi-image"></i>

                      <strong>No image selected</strong>

                      <span>JPG, PNG or WebP</span>
                    </div>
                  </div>

                  <label for="galleryImage" class="image-upload-btn">
                    <i class="bi bi-cloud-arrow-up"></i>
                    Choose Image
                  </label>

                  <input
                    type="file"
                    id="galleryImage"
                    name="image"
                    accept="image/jpeg,image/png,image/webp"
                    hidden
                  />

                  <div class="image-help">
                    Recommended image size according to your website design.

                    <br />

                    Maximum file size:
                    <strong>2MB</strong>
                  </div>
                </div>
              </div>

              <!-- ACTIONS -->

              <div class="form-actions">
                <a href="/admin/gallery" class="cancel-btn"> Cancel </a>

                <button
                  type="submit"
                  class="save-service-btn"
                  id="saveGalleryBtn"
                >
                  <i class="bi bi-check-lg"></i>

                  <span id="saveGalleryButtonText"> Save Image </span>
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </main>

    <script src="assets/js/style.js"></script>
    <script src="/admin-js/gallery.js"></script>
  </body>
</html>
