<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Metro Cool - Admin Services</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/admin-css/admin.css" />
  </head>

  <body>
    <div class="admin-layout">
      <!-- =========================================
         SIDEBAR
    ========================================== -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-inner">
          <!-- Logo -->
          <div class="brand">
            <div class="brand-icon">
              <i class="bi bi-flower1"></i>
            </div>

            <div class="brand-content">
              <h1>Metro Cool</h1>
              <span>Service Listing</span>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="sidebar-nav">
            <a href="/admin/dashboard" class="nav-item">
              <i class="bi bi-house-fill"></i>
              <span>Dashboard</span>
            </a>

            <a href="/admin/services" class="nav-item">
              <i class="bi bi-grid-3x3-gap"></i>
              <span>Services</span>
            </a>

            <a href="/admin/main banners" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Main Banners</span>
            </a>

            <a href="/admin/mobile banners" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Mobile Banners</span>
            </a>

            <a href="/admin/blogs" class="nav-item active">
              <i class="bi bi-file-earmark-text"></i>
              <span>Blogs</span>
            </a>

            <a href="/admin/gallery" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Gallery</span>
            </a>

            <a href="/admin/testimonials" class="nav-item">
              <i class="bi bi-chat-square-text"></i>
              <span>Testimonials</span>
            </a>
          </nav>

          <!-- Bottom Section -->
          <div class="sidebar-bottom">
            <a href="#" class="logout-link">
              <i class="bi bi-box-arrow-right"></i>
              <span>Logout</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Sidebar overlay for mobile -->
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <!-- =========================================
         MAIN CONTENT
    ========================================== -->
      <main class="main-content">
        <!-- =========================================
         TOP HEADER
    ========================================== -->

        <header class="top-header">
          <div class="header-left">
            <!-- Search -->
            <div class="header-search">
              <input type="text" placeholder="Search anything..." />

              <button type="button">
                <i class="bi bi-search"></i>
              </button>
            </div>
          </div>

          <div class="header-right">
            <!-- User -->
            <div class="header-user">
              <div class="header-user-info">
                <strong>Metro Cool</strong>
                <span>Admin</span>
              </div>

              <div class="header-user-avatar">
                <img src="assets/images/user.jpg" alt="Admin" />
              </div>
            </div>
          </div>
        </header>

        <!-- =========================================
         BLOG CONTENT
    ========================================== -->

        <div class="dashboard-content blogs-page">
          <!-- =====================================
             PAGE HEADER
        ====================================== -->

          <div class="blogs-page-header">
            <div class="page-title-wrapper">
              <h2>Blogs</h2>

              <div class="breadcrumb-custom">
                <a href="index.html"> Dashboard </a>

                <i class="bi bi-chevron-right"></i>

                <span> Blogs </span>
              </div>
            </div>

            <!-- Add Blog -->

            <a href="/admin/blog-form" class="add-blog-btn">
              <i class="bi bi-plus-lg"></i>

              <span> Add New Blog </span>
            </a>
          </div>

          <!-- =====================================
             FILTER TOOLBAR
        ====================================== -->

          <div class="blogs-toolbar">
            <div class="blogs-filters">
              <div class="blog-search">
                <i class="bi bi-search"></i>

                <input
                  type="text"
                  id="blogSearch"
                  placeholder="Search blogs..."
                />
              </div>

              <div class="blog-filter-select">
                <select id="blogStatusFilter">
                  <option value="">All Status</option>
                  <option value="published">Published</option>
                  <option value="draft">Draft</option>
                </select>

                <i class="bi bi-chevron-down"></i>
              </div>
            </div>
          </div>

          <!-- =====================================
             BLOG TABLE
        ====================================== -->

          <div class="blogs-table-wrapper">
            <table class="blogs-table">
              <thead>
                <tr>
                  <th class="blog-column">BLOG</th>


                  <th>STATUS</th>

                  <th>DATE</th>

                  <th class="actions-column">ACTIONS</th>
                </tr>
              </thead>

              <tbody id="blogsTableBody"></tbody>
            </table>
          </div>

          <!-- =====================================
             EMPTY STATE
        ====================================== -->

          <div class="blogs-empty" id="blogsEmpty">
            <i class="bi bi-journal-text"></i>

            <h4>No blogs found</h4>

            <p>Try changing your search or filters.</p>
          </div>

          <!-- =====================================
             TABLE FOOTER
        ====================================== -->

          <div class="blogs-footer">
            <div class="blogs-count">
              Showing
              <strong id="visibleBlogCount">0</strong>
              to
              <strong id="totalVisibleBlogCount">0</strong>
              of
              <strong id="totalBlogCount">0</strong>
              entries
            </div>

            <!-- Pagination -->

            <div class="blogs-pagination" id="blogsPagination"></div>
          </div>
        </div>
      </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/blog.js"></script>
  </body>
</html>
