<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Testimonial Management | Metro Cool Admin</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/admin-css/admin.css" />
  </head>

  <body>
    <div class="admin-layout">
      <!-- =========================================
         SIDEBAR
    ========================================== -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-inner">
          <!-- Logo -->
          <div class="brand">
            <div class="brand-icon">
              <i class="bi bi-flower1"></i>
            </div>

            <div class="brand-content">
              <h1>Metro Cool</h1>
              <span>Service Listing</span>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="sidebar-nav">
            <a href="/admin/dashboard" class="nav-item">
              <i class="bi bi-house-fill"></i>
              <span>Dashboard</span>
            </a>

            <a href="/admin/services" class="nav-item">
              <i class="bi bi-grid-3x3-gap"></i>
              <span>Services</span>
            </a>

            <a href="/admin/main-banners" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Main Banners</span>
            </a>

            <a href="/admin/mobile-banners" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Mobile Banners</span>
            </a>

            <a href="/admin/blogs" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Blogs</span>
            </a>

            <a href="/admin/gallery" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Gallery</span>
            </a>

            <a href="/admin/testimonials" class="nav-item active">
              <i class="bi bi-chat-square-text"></i>
              <span>Testimonials</span>
            </a>
          </nav>

          <!-- Bottom Section -->
          <div class="sidebar-bottom">
            <a href="#" class="logout-link">
              <i class="bi bi-box-arrow-right"></i>
              <span>Logout</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Sidebar overlay for mobile -->
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <!-- =========================================
         MAIN CONTENT
    ========================================== -->
      <!-- =====================================================
     TESTIMONIALS PAGE
===================================================== -->

      <main class="main-content">
        <!-- =================================================
         TOP HEADER
    ================================================== -->

        <header class="top-header">
          <div class="header-left">
            <!-- Search -->
            <div class="header-search">
              <input type="text" placeholder="Search anything..." />

              <button type="button">
                <i class="bi bi-search"></i>
              </button>
            </div>
          </div>

          <div class="header-right">
            <!-- User -->
            <div class="header-user">
              <div class="header-user-info">
                <strong>Metro Cool</strong>
                <span>Admin</span>
              </div>

              <div class="header-user-avatar">
                <img src="assets/images/user.jpg" alt="Admin" />
              </div>
            </div>
          </div>
        </header>

        <!-- =================================================
         PAGE CONTENT
    ================================================== -->

        <div class="dashboard-content testimonials-page">
          <!-- =================================================
             PAGE HEADER
        ================================================== -->

          <div class="testimonials-page-header">
            <div class="page-title-wrapper">
              <h2>Testimonials</h2>

              <div class="breadcrumb-custom">
                <a href="/admin/dashboard"> Dashboard </a>

                <i class="bi bi-chevron-right"></i>

                <span> Testimonials </span>
              </div>
            </div>

            <!-- Add Testimonial -->

            <a href="/admin/testimonial-form" class="add-testimonial-btn">
              <i class="bi bi-plus-lg"></i>

              <span>Add New Testimonial</span>
            </a>
          </div>

          <!-- =================================================
             TESTIMONIAL TABLE
        ================================================== -->

          <div class="testimonials-table-wrapper">
            <table class="testimonials-table">
              <thead>
                <tr>
                  <th class="customer-column">CUSTOMER</th>

                  <th class="service-column">SERVICE</th>

                  <th class="rating-column">RATING</th>

                  <th class="status-column">STATUS</th>

                  <th class="testimonial-actions-column">ACTIONS</th>
                </tr>
              </thead>

              <tbody id="testimonialsTableBody"></tbody>
            </table>
          </div>

          <!-- =================================================
             EMPTY STATE
        ================================================== -->

          <div class="testimonials-empty" id="testimonialsEmpty">
            <i class="bi bi-chat-quote"></i>

            <h4>No testimonials found</h4>

            <p>Try changing your search or filters.</p>
          </div>

          <!-- =================================================
             FOOTER
        ================================================== -->

          <div class="testimonials-footer">
            <div class="testimonials-count" id="testimonialsCount">
              Showing <strong>0</strong> to <strong>0</strong> of
              <strong>0</strong> entries
            </div>

            <div
              class="testimonials-pagination"
              id="testimonialsPagination"
            ></div>
          </div>
        </div>
      </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/testimonial.js"></script>
  </body>
</html>
