<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Metro Cool - Admin Services</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/admin-css/admin.css" />

    <!-- font awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>

  <body>
    <div class="admin-layout">
      <!-- =========================================
         SIDEBAR
    ========================================== -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-inner">
          <!-- Logo -->
          <div class="brand">
            <div class="brand-icon">
              <i class="bi bi-flower1"></i>
            </div>

            <div class="brand-content">
              <h1>Metro Cool</h1>
              <span>Service Listing</span>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="sidebar-nav">
            <a href="dashboard.html" class="nav-item">
              <i class="bi bi-house-fill"></i>
              <span>Dashboard</span>
            </a>

            <a href="services.html" class="nav-item active">
              <i class="bi bi-grid-3x3-gap"></i>
              <span>Services</span>
            </a>

            <a href="banners.html" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Banners</span>
            </a>

            <a href="blogs.html" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Blogs</span>
            </a>

            <a href="testimonials.html" class="nav-item">
              <i class="bi bi-chat-square-text"></i>
              <span>Testimonials</span>
            </a>
          </nav>

          <!-- Bottom Section -->
          <div class="sidebar-bottom">
            <a href="#" class="logout-link">
              <i class="bi bi-box-arrow-right"></i>
              <span>Logout</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Sidebar overlay for mobile -->
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <!-- =========================================
         MAIN CONTENT
    ========================================== -->
      <main class="main-content">
        <!-- =========================================
         TOP HEADER
    ========================================== -->
        <header class="top-header">
          <div class="header-left">
            <!-- Search -->
            <div class="header-search">
              <input type="text" placeholder="Search anything..." />

              <button type="button">
                <i class="bi bi-search"></i>
              </button>
            </div>
          </div>

          <div class="header-right">
            <!-- User -->
            <div class="header-user">
              <div class="header-user-info">
                <strong>Metro Cool</strong>
                <span>Admin</span>
              </div>

              <div class="header-user-avatar">
                <img src="assets/images/user.jpg" alt="Admin" />
              </div>
            </div>
          </div>
        </header>

        <!-- =========================================
         SERVICES CONTENT
    ========================================== -->

        <div class="dashboard-content services-page">
          <!-- =====================================
             PAGE TOP
        ====================================== -->

          <div class="services-page-header">
            <div class="page-title-wrapper">
              <h2>Services</h2>

              <div class="breadcrumb-custom">
                <a href="index.html"> Dashboard </a>

                <i class="bi bi-chevron-right"></i>

                <span>Services</span>
              </div>
            </div>

            <!-- Add Service -->
            <a href="/admin/service-form" class="add-service-btn">
              <i class="bi bi-plus-lg"></i>

              <span>Add New Service</span>
            </a>
          </div>

          <!-- =====================================
             FILTER BAR
        ====================================== -->

          <div class="services-toolbar">
            <div class="services-filters">
              <!-- Search -->
              <div class="service-search">
                <i class="bi bi-search"></i>

                <input
                  type="text"
                  id="serviceSearch"
                  placeholder="Search services..."
                />
              </div>

              <!-- Category -->
              <div class="filter-select">
                <select id="categoryFilter">
                  <option value="">All Categories</option>

                  <option value="AC">AC</option>

                  <option value="Refrigeration">Refrigeration</option>

                  <option value="Washing Machine">Washing Machine</option>

                  
                </select>

                <i class="bi bi-chevron-down"></i>
              </div>

              <!-- Status -->
              <div class="filter-select">
                <select id="statusFilter">
                  <option value="">All Status</option>

                  <option value="published">Published</option>

                  <option value="draft">Draft</option>
                </select>

                <i class="bi bi-chevron-down"></i>
              </div>
            </div>
          </div>

          <!-- =====================================
             SERVICES GRID
        ====================================== -->

          <div class="services-list row g-3" id="servicesList"></div>

          <!-- =====================================
             NO RESULTS
        ====================================== -->

          <div class="services-empty mt-5" id="servicesEmpty">
            <i class="bi bi-search"></i>

            <h4>No services found</h4>

            <p>Try changing your search or filters.</p>
          </div>

          <!-- =====================================
             PAGINATION
        ====================================== -->

          <div class="services-pagination">
            <button type="button" class="pagination-btn disabled">
              <i class="bi bi-chevron-left"></i>
            </button>

            <button type="button" class="pagination-btn active">1</button>

            <button type="button" class="pagination-btn">2</button>

            <button type="button" class="pagination-btn">3</button>

            <span class="pagination-dots"> ... </span>

            <button type="button" class="pagination-btn">16</button>

            <button type="button" class="pagination-btn">
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>
        </div>
      </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/service.js"></script>
  </body>
</html>
