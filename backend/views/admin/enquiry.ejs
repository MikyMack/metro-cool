<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Testimonial Management | Metro Cool Admin</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/admin-css/admin.css" />
  </head>

  <body>
    <div class="admin-layout">
      <!-- =========================================
         SIDEBAR
    ========================================== -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-inner">
          <!-- Logo -->
          <div class="brand">
            <div class="brand-icon">
              <i class="bi bi-flower1"></i>
            </div>

            <div class="brand-content">
              <h1>Metro Cool</h1>
              <span>Service Listing</span>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="sidebar-nav">
            <a href="/admin/dashboard" class="nav-item">
              <i class="bi bi-house-fill"></i>
              <span>Dashboard</span>
            </a>

            <a href="/admin/services" class="nav-item">
              <i class="bi bi-grid-3x3-gap"></i>
              <span>Services</span>
            </a>

            <a href="/admin/main-banners" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Main Banners</span>
            </a>

            <a href="/admin/mobile-banners" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Mobile Banners</span>
            </a>

            <a href="/admin/blogs" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Blogs</span>
            </a>

            <a href="/admin/gallery" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Gallery</span>
            </a>

            <a href="/admin/testimonials" class="nav-item ">
              <i class="bi bi-chat-square-text"></i>
              <span>Testimonials</span>
            </a>

            <a href="/admin/enquiries" class="nav-item  active">
              <i class="bi bi-inbox"></i>
              <span>Enquiries</span>
            </a>
          </nav>

          <!-- Bottom Section -->
          <div class="sidebar-bottom">
            <a href="/admin/logout" class="logout-link">
              <i class="bi bi-box-arrow-right"></i>
              <span>Logout</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Sidebar overlay for mobile -->
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <!-- =========================================
         MAIN CONTENT
    ========================================== -->
      <!-- =====================================================
     TESTIMONIALS PAGE
===================================================== -->

      <main class="main-content">
        <!-- =================================================
       TOP HEADER
  ================================================== -->

        <header class="top-header">
          <div class="header-left">
            <button class="sidebar-toggle" id="sidebarToggle">
              <i class="bi bi-list"></i>
            </button>
          </div>

          <div class="header-right">
            <!-- User -->
            <div class="header-user">
              <div class="header-user-info">
                <strong>Metro Cool</strong>
                <span>Admin</span>
              </div>

              <div class="header-user-avatar">
                <img src="assets/images/user.jpg" alt="Admin" />
              </div>
            </div>
          </div>
        </header>

        <!-- =================================================
       PAGE CONTENT
  ================================================== -->

        <div class="dashboard-content enquiries-page">
          <!-- =================================================
         PAGE HEADER
    ================================================== -->

          <div class="enquiries-page-header">
            <div class="page-title-wrapper">
              <h2>Enquiries</h2>

              <div class="breadcrumb-custom">
                <a href="index.html"> Dashboard </a>

                <i class="bi bi-chevron-right"></i>

                <span> Enquiries </span>
              </div>
            </div>

            <!-- Filter -->

            <div class="enquiries-header-filter">
              <select id="enquiryStatusFilter">
                <option value="">All Status</option>
                <option value="new">New</option>
                <option value="contacted">Contacted</option>
                <option value="in-progress">In Progress</option>
                <option value="completed">Completed</option>
                <option value="cancelled">Cancelled</option>
              </select>
            </div>
          </div>

          <!-- =================================================
         ENQUIRY TABLE
    ================================================== -->

          <div class="enquiries-table-wrapper">
            <table class="enquiries-table">
              <thead>
                <tr>
                  <th class="enquiry-customer-column">CUSTOMER</th>

                  <th class="enquiry-source-column">SOURCE</th>

                  <th class="enquiry-service-column">SERVICE</th>

                  <th class="enquiry-contact-column">CONTACT</th>

                  <th class="enquiry-status-column">STATUS</th>

                  <th class="enquiry-date-column">DATE</th>

                  <th class="enquiry-actions-column">ACTIONS</th>
                </tr>
              </thead>

              <tbody id="enquiriesTableBody">
                <!-- Dynamic enquiries -->
              </tbody>
            </table>
          </div>

          <!-- =================================================
         EMPTY STATE
    ================================================== -->

          <div class="enquiries-empty" id="enquiriesEmpty">
            <i class="bi bi-inbox"></i>

            <h4>No enquiries found</h4>

            <p>Try changing your search or filters.</p>
          </div>

          <!-- =================================================
         FOOTER
    ================================================== -->

          <div class="enquiries-footer">
            <div class="enquiries-count">
              Showing
              <strong id="enquiryStartCount">0</strong>

              to

              <strong id="enquiryEndCount">0</strong>

              of

              <strong id="enquiryTotalCount">0</strong>

              entries
            </div>

            <!-- Pagination -->

            <div class="enquiries-pagination" id="enquiriesPagination"></div>
          </div>
        </div>
      </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/enquiries.js"></script>
  </body>
</html>
