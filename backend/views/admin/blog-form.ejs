<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Blog Management | Metro Cool Admin</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Common styles -->
    <link rel="stylesheet" href="/admin-css/admin.css" />

    <!-- Quill Editor -->
    <link
      href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar" id="sidebar">
      <div class="sidebar-inner">
        <!-- Logo -->
        <div class="brand">
          <div class="brand-icon">
            <i class="bi bi-flower1"></i>
          </div>

          <div class="brand-content">
            <h1>Metro Cool</h1>
            <span>Service Listing</span>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav">
          <a href="/admin/dashboard" class="nav-item">
            <i class="bi bi-house-fill"></i>
            <span>Dashboard</span>
          </a>

          <a href="/admin/services" class="nav-item">
            <i class="bi bi-grid-3x3-gap"></i>
            <span>Services</span>
          </a>

          <a href="/admin/main-banners" class="nav-item">
            <i class="bi bi-image"></i>
            <span>Main Banners</span>
          </a>

          <a href="/admin/mobile-banners" class="nav-item">
            <i class="bi bi-image"></i>
            <span>Mobile Banners</span>
          </a>

          <a href="/admin/blogs" class="nav-item">
            <i class="bi bi-file-earmark-text"></i>
            <span>Blogs</span>
          </a>

          <a href="/admin/gallery" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Gallery</span>
            </a>

          <a href="/admin/testimonials" class="nav-item">
            <i class="bi bi-chat-square-text"></i>
            <span>Testimonials</span>
          </a>

          <a href="/admin/enquiries" class="nav-item">
              <i class="bi bi-inbox"></i>
              <span>Enquiries</span>
            </a>
        </nav>

        <!-- Bottom Section -->
        <div class="sidebar-bottom">
          <a href="/admin/logout" class="logout-link">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Mobile sidebar overlay -->

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="main-content">
      <!-- =================================================
             HEADER
        ================================================== -->

      <header class="top-header">
          <div class="header-left">
            <button class="sidebar-toggle" id="sidebarToggle">
              <i class="bi bi-list"></i>
            </button>
          </div>

          <div class="header-right">
            <!-- User -->
            <div class="header-user">
              <div class="header-user-info">
                <strong>Metro Cool</strong>
                <span>Admin</span>
              </div>

              <div class="header-user-avatar">
                <img src="assets/images/user.jpg" alt="Admin" />
              </div>
            </div>
          </div>
        </header>

      <!-- =================================================
             PAGE CONTENT
        ================================================== -->

      <div class="dashboard-content service-form-page">
        <!-- PAGE HEADER -->

        <div class="service-form-header">
          <div>
            <h2 id="formPageTitle">Add New Blog</h2>

            <div class="breadcrumb-custom">
              <a href="index.html"> Dashboard </a>

              <i class="bi bi-chevron-right"></i>

              <a href="blogs.html"> Blogs </a>

              <i class="bi bi-chevron-right"></i>

              <span id="breadcrumbCurrent"> Add Blog </span>
            </div>
          </div>

          <a href="/admin/blogs" class="back-btn">
            <i class="bi bi-arrow-left"></i>

            Back to Blogs
          </a>
        </div>

        <!-- =================================================
                 FORM
            ================================================== -->

        <form id="blogForm" class="blog-form">
          <div class="row g-4">
            <!-- =================================================
                         LEFT COLUMN
                    ================================================== -->

            <div class="col-12 col-xl-8">
              <div class="form-card">
                <div class="form-card-header">
                  <div>
                    <h3>Blog Information</h3>

                    <p>Add the title and content for your blog.</p>
                  </div>
                </div>

                <div class="form-card-body">
                  <!-- TITLE -->

                  <div class="form-group">
                    <label for="blogTitle">
                      Title

                      <span>*</span>
                    </label>

                    <input
                      type="text"
                      id="blogTitle"
                      name="title"
                      class="form-control-custom"
                      placeholder="Enter blog title"
                      required
                    />
                  </div>

                  <!-- AUTHOR -->

                  <div class="form-group">
                    <label for="blogAuthor">
                      Author
                      <span>*</span>
                    </label>

                    <input
                      type="text"
                      id="blogAuthor"
                      name="author"
                      class="form-control-custom"
                      placeholder="Enter author name"
                      required
                    />
                  </div>

                  <!-- SLUG -->

                  <div class="form-group">
                    <label for="blogSlug"> Slug </label>

                    <div class="slug-input">
                      <span> /blog/ </span>

                      <input
                        type="text"
                        id="blogSlug"
                        name="slug"
                        placeholder="blog-title"
                      />
                    </div>

                    <small> The slug is used in the blog URL. </small>
                  </div>

                  <!-- SEO -->

                  <div class="form-card-header" style="margin-top: 30px">
                    <div>
                      <h3>SEO Information</h3>
                      <p>
                        Configure the search engine information for this blog.
                      </p>
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="metaTitle">
                      Meta Title
                      <span>*</span>
                    </label>

                    <input
                      type="text"
                      id="metaTitle"
                      name="metaTitle"
                      class="form-control-custom"
                      placeholder="Enter SEO title"
                      maxlength="60"
                      required
                    />

                    <div class="field-footer">
                      <small>Recommended: 50–60 characters.</small>
                      <span id="metaTitleCount">0 / 60</span>
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="metaDescription">
                      Meta Description
                      <span>*</span>
                    </label>

                    <textarea
                      id="metaDescription"
                      name="metaDescription"
                      class="form-control-custom"
                      rows="4"
                      maxlength="160"
                      placeholder="Enter SEO description"
                      required
                    ></textarea>

                    <div class="field-footer">
                      <small>Recommended: 150–160 characters.</small>
                      <span id="metaDescriptionCount">0 / 160</span>
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="metaKeywords">
                      Meta Keywords
                      <span>*</span>
                    </label>

                    <input
                      type="text"
                      id="metaKeywords"
                      name="metaKeywords"
                      class="form-control-custom"
                      placeholder="AC service, AC repair, AC maintenance"
                      required
                    />

                    <small> Separate keywords using commas. </small>
                  </div>

                  <!-- CONTENT -->

                  <div class="form-group">
                    <label for="blogContent">
                      Blog Content

                      <span>*</span>
                    </label>

                    <div
                      id="blogContentEditor"
                      class="blog-content-editor"
                    ></div>

                    <textarea id="blogContent" name="content" hidden></textarea>

                    <small> Add the complete content of the blog. </small>
                  </div>
                </div>
              </div>
            </div>

            <!-- =================================================
                         RIGHT COLUMN
                    ================================================== -->

            <div class="col-12 col-xl-4">
              <!-- FEATURED IMAGE -->

              <div class="form-card">
                <div class="form-card-header">
                  <div>
                    <h3>Featured Image</h3>

                    <p>Upload the main image for this blog.</p>
                  </div>
                </div>

                <div class="form-card-body">
                  <div
                    class="service-image-preview blog-image-preview"
                    id="blogImagePreview"
                  >
                    <div class="image-placeholder">
                      <i class="bi bi-image"></i>

                      <strong> No image selected </strong>

                      <span> JPG, PNG or WebP </span>
                    </div>
                  </div>

                  <label for="blogImage" class="image-upload-btn">
                    <i class="bi bi-cloud-arrow-up"></i>

                    Choose Image
                  </label>

                  <input
                    type="file"
                    id="blogImage"
                    name="image"
                    accept="image/jpeg,image/png,image/webp"
                    hidden
                  />

                  <div class="image-help">
                    Recommended:
                    <strong>1200 × 800px</strong>

                    <br />

                    Maximum file size:
                    <strong>2MB</strong>
                  </div>
                </div>
              </div>

              <!-- STATUS -->

              <div class="form-card publishing-card">
                <div class="form-card-header">
                  <div>
                    <h3>Publishing</h3>

                    <p>Control the visibility of your blog.</p>
                  </div>
                </div>

                <div class="form-card-body">
                  <div class="form-group">
                    <label for="blogStatus"> Status </label>

                    <div class="select-wrapper">
                      <select
                        id="blogStatus"
                        name="status"
                        class="form-control-custom"
                      >
                        <option value="published">Published</option>

                        <option value="draft">Draft</option>
                      </select>

                      <i class="bi bi-chevron-down"></i>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ACTIONS -->

              <div class="form-actions">
                <a href="/admin/blogs" class="cancel-btn"> Cancel </a>

                <button type="submit" class="save-service-btn">
                  <i class="bi bi-check-lg"></i>

                  <span id="saveButtonText"> Save Blog </span>
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/blog.js"></script>

  </body>
</html>
