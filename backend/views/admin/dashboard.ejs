<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Dashboard | Metro Cool Admin</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/admin-css/admin.css" />
  </head>

  <body>
    <div class="admin-layout">
      <!-- =========================================
         SIDEBAR
    ========================================== -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-inner">
          <!-- Logo -->
          <div class="brand">
            <div class="brand-icon">
              <i class="bi bi-flower1"></i>
            </div>

            <div class="brand-content">
              <h1>Metro Cool</h1>
              <span>Service Listing</span>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="sidebar-nav">
            <a href="/admin/dashboard" class="nav-item active">
              <i class="bi bi-house-fill"></i>
              <span>Dashboard</span>
            </a>

            <a href="/admin/services" class="nav-item">
              <i class="bi bi-grid-3x3-gap"></i>
              <span>Services</span>
            </a>

            <a href="/admin/main-banners" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Main Banners</span>
            </a>

            <a href="/admin/mobile-banners" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Mobile Banners</span>
            </a>

            <a href="/admin/blogs" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Blogs</span>
            </a>

            <a href="/admin/gallery" class="nav-item">
              <i class="bi bi-file-earmark-text"></i>
              <span>Gallery</span>
            </a>

            <a href="/admin/testimonials" class="nav-item">
              <i class="bi bi-chat-square-text"></i>
              <span>Testimonials</span>
            </a>

            <a href="/admin/enquiries" class="nav-item">
              <i class="bi bi-inbox"></i>
              <span>Enquiries</span>
            </a>
          </nav>

          <!-- Bottom Section -->
          <div class="sidebar-bottom">
            <a href="/admin/logout" class="logout-link">
              <i class="bi bi-box-arrow-right"></i>
              <span>Logout</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Sidebar overlay for mobile -->
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <!-- =========================================
         MAIN CONTENT
    ========================================== -->
      <main class="main-content">
        <!-- =====================================
             TOP HEADER
        ====================================== -->
        <header class="top-header">
          <div class="header-left">
            <button class="sidebar-toggle" id="sidebarToggle">
              <i class="bi bi-list"></i>
            </button>
          </div>

          <div class="header-right">
            <!-- User -->
            <div class="header-user">
              <div class="header-user-info">
                <strong>Metro Cool</strong>
                <span>Admin</span>
              </div>

              <div class="header-user-avatar">
                <img src="assets/images/user.jpg" alt="Admin" />
              </div>
            </div>
          </div>
        </header>

        <!-- =====================================
             PAGE CONTENT
        ====================================== -->
        <div class="dashboard-content">
          <!-- Page Heading -->
          <div class="page-heading">
            <div>
              <h2>
                Welcome back, Admin
                <span class="wave">👋</span>
              </h2>

              <p>Here's an overview of your platform.</p>
            </div>
          </div>

          <!-- =====================================
                 STAT CARDS
            ====================================== -->
          <section class="stats-section">
            <div class="row g-3 mb-4">
              <!-- Services -->
              <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                  <div class="stat-icon services-icon">
                    <i class="bi bi-grid-3x3-gap"></i>
                  </div>

                  <div class="stat-content">
                    <span class="stat-label">Total Services</span>

                    <strong class="stat-number" id="totalServices"> 0 </strong>

                    <span class="stat-growth" id="servicesGrowth"> -- </span>
                  </div>
                </div>
              </div>

              <!-- Blogs -->
              <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                  <div class="stat-icon blogs-icon">
                    <i class="bi bi-chat-left-text"></i>
                  </div>

                  <div class="stat-content">
                    <span class="stat-label">Total Blogs</span>

                    <strong class="stat-number" id="totalBlogs"> 0 </strong>

                    <span class="stat-growth" id="blogsGrowth"> -- </span>
                  </div>
                </div>
              </div>

              <!-- Testimonials -->
              <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                  <div class="stat-icon testimonial-icon">
                    <i class="bi bi-star"></i>
                  </div>

                  <div class="stat-content">
                    <span class="stat-label"> Total Testimonials </span>

                    <strong class="stat-number" id="totalTestimonials">
                      0
                    </strong>

                    <span class="stat-growth" id="testimonialsGrowth">
                      --
                    </span>
                  </div>
                </div>
              </div>

              <!-- Banners -->
              <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                  <div class="stat-icon banners-icon">
                    <i class="bi bi-grid"></i>
                  </div>

                  <div class="stat-content">
                    <span class="stat-label"> Total Banners </span>

                    <strong class="stat-number" id="totalBanners"> 0 </strong>

                    <span class="stat-growth" id="bannersGrowth"> -- </span>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- =====================================
                 LOWER CONTENT
            ====================================== -->
          <section class="lower-section">
            <div class="row g-3">
              <!-- Recent Services -->
              <div class="col-12 col-xl-8">
                <div class="dashboard-card recent-services-card">
                  <div class="card-header-custom">
                    <h3>Recent Services</h3>

                    <button
                      type="button"
                      class="view-all-btn"
                      onclick="window.location.href = '/admin/services'"
                    >
                      View all
                    </button>
                  </div>

                  <!-- Services -->
                  <div class="services-grid" id="recentServices"></div>
                </div>
              </div>

              <!-- =================================
                         QUICK ACTIONS
                    ================================== -->
              <div class="col-12 col-xl-4">
                <div class="dashboard-card quick-actions-card">
                  <div class="card-header-custom">
                    <h3>Quick Actions</h3>
                  </div>

                  <div class="quick-actions">
                    <a href="/admin/service-form" class="quick-action">
                      <span class="quick-action-icon">
                        <i class="bi bi-file-earmark-plus"></i>
                      </span>

                      <span>Add New Service</span>

                      <i class="bi bi-chevron-right action-arrow"></i>
                    </a>

                    <a href="/admin/main-banner-form" class="quick-action">
                      <span class="quick-action-icon">
                        <i class="bi bi-image"></i>
                      </span>

                      <span>Add New Main Banner</span>

                      <i class="bi bi-chevron-right action-arrow"></i>
                    </a>

                    <a href="/admin/mobile-banner-form" class="quick-action">
                      <span class="quick-action-icon">
                        <i class="bi bi-image"></i>
                      </span>

                      <span>Add New Mobile Banner</span>

                      <i class="bi bi-chevron-right action-arrow"></i>
                    </a>

                    <a href="/admin/blog-form" class="quick-action">
                      <span class="quick-action-icon">
                        <i class="bi bi-file-earmark-text"></i>
                      </span>

                      <span>Create New Blog</span>

                      <i class="bi bi-chevron-right action-arrow"></i>
                    </a>

                    <a href="/admin/gallery-form" class="quick-action">
                      <span class="quick-action-icon">
                        <i class="bi bi-images"></i>
                      </span>

                      <span>Add Gallery Image</span>

                      <i class="bi bi-chevron-right action-arrow"></i>
                    </a>

                    <a href="/admin/testimonial-form" class="quick-action">
                      <span class="quick-action-icon">
                        <i class="bi bi-chat-square-text"></i>
                      </span>

                      <span>Add Testimonial</span>

                      <i class="bi bi-chevron-right action-arrow"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/dashboard.js"></script>
  </body>
</html>
