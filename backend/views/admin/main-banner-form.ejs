<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Main Banner Management | Metro Cool Admin</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Common Styles -->
    <link rel="stylesheet" href="/admin-css/admin.css" />
  </head>

  <body>
    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar" id="sidebar">
      <div class="sidebar-inner">
        <!-- Logo -->
        <div class="brand">
          <div class="brand-icon">
            <i class="bi bi-flower1"></i>
          </div>

          <div class="brand-content">
            <h1>Metro Cool</h1>
            <span>Service Listing</span>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav">
          <a href="/admin/dashboard" class="nav-item">
            <i class="bi bi-house-fill"></i>
            <span>Dashboard</span>
          </a>

          <a href="/admin/services" class="nav-item">
            <i class="bi bi-grid-3x3-gap"></i>
            <span>Services</span>
          </a>

          <a href="/admin/main-banners" class="nav-item">
            <i class="bi bi-image"></i>
            <span>Main Banners</span>
          </a>

          <a href="/admin/mobile-banners" class="nav-item">
            <i class="bi bi-image"></i>
            <span>Mobile Banners</span>
          </a>

          <a href="/admin/blogs" class="nav-item">
            <i class="bi bi-file-earmark-text"></i>
            <span>Blogs</span>
          </a>

          <a href="/admin/gallery" class="nav-item">
            <i class="bi bi-file-earmark-text"></i>
            <span>Gallery</span>
          </a>

          <a href="/admin/testimonials" class="nav-item">
            <i class="bi bi-chat-square-text"></i>
            <span>Testimonials</span>
          </a>
        </nav>

        <!-- Bottom Section -->
        <div class="sidebar-bottom">
          <a href="/admin/logout" class="logout-link">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Mobile overlay -->

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="main-content">
      <!-- HEADER -->

      <header class="top-header">
        <div class="header-left">
          <button class="sidebar-toggle" id="sidebarToggle">
            <i class="bi bi-list"></i>
          </button>
        </div>

        <div class="header-right">
          <!-- User -->
          <div class="header-user">
            <div class="header-user-info">
              <strong>Metro Cool</strong>
              <span>Admin</span>
            </div>

            <div class="header-user-avatar">
              <img src="assets/images/user.jpg" alt="Admin" />
            </div>
          </div>
        </div>
      </header>

      <!-- =====================================================
             PAGE
        ====================================================== -->

      <div class="dashboard-content service-form-page">
        <!-- PAGE HEADER -->

        <div class="service-form-header">
          <div>
            <h2 id="formPageTitle">Add New Banner</h2>

            <div class="breadcrumb-custom">
              <a href="index.html"> Dashboard </a>

              <i class="bi bi-chevron-right"></i>

              <a href="banners.html"> Banners </a>

              <i class="bi bi-chevron-right"></i>

              <span id="breadcrumbCurrent"> Add Banner </span>
            </div>
          </div>

          <a href="/admin/main-banners" class="back-btn">
            <i class="bi bi-arrow-left"></i>

            Back to Banners
          </a>
        </div>

        <!-- =====================================================
                 FORM
            ====================================================== -->

        <form id="bannerForm" class="banner-form">
          <div class="row g-4">
            <!-- =================================================
                         LEFT : BANNER CONTENT
                    ================================================== -->

            <div class="col-12 col-xl-8">
              <div class="form-card">
                <div class="form-card-header">
                  <div>
                    <h3>Banner Information</h3>

                    <p>Add the content that will appear on the banner.</p>
                  </div>
                </div>

                <div class="form-card-body">
                  <!-- Subtitle -->

                  <div class="form-group">
                    <label for="bannerSubtitle"> Subtitle </label>

                    <input
                      type="text"
                      id="bannerSubtitle"
                      name="subtitle"
                      class="form-control-custom"
                      placeholder="e.g. Quality Services"
                    />
                  </div>

                  <!-- Title -->

                  <div class="form-group">
                    <label for="bannerTitle"> Title </label>

                    <input
                      type="text"
                      id="bannerTitle"
                      name="title"
                      class="form-control-custom"
                      placeholder="Enter banner title"
                    />
                  </div>

                  <!-- Description -->

                  <div class="form-group">
                    <label for="bannerDescription"> Description </label>

                    <textarea
                      id="bannerDescription"
                      name="description"
                      class="form-control-custom banner-description"
                      rows="6"
                      placeholder="Enter a short description for the banner..."
                    ></textarea>
                  </div>

                  <!-- Link -->

                  <div class="form-group">
                    <label for="bannerLink">Link</label>

                    <input
                      type="text"
                      id="bannerLink"
                      name="link"
                      class="form-control-custom"
                      placeholder="e.g. /services"
                    />
                  </div>

                  <!-- Status -->

                  <div class="form-group">
                    <label for="bannerStatus"> Status </label>

                    <div class="select-wrapper">
                      <select
                        id="bannerStatus"
                        name="status"
                        class="form-control-custom"
                      >
                        <option value="active">Active</option>

                        <option value="inactive">Inactive</option>
                      </select>

                      <i class="bi bi-chevron-down"></i>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- =================================================
                         RIGHT : IMAGE
                    ================================================== -->

            <div class="col-12 col-xl-4">
              <div class="form-card">
                <div class="form-card-header">
                  <div>
                    <h3>Banner Image</h3>

                    <p>Upload the main banner image.</p>
                  </div>
                </div>

                <div class="form-card-body">
                  <div
                    class="service-image-preview banner-image-preview"
                    id="bannerImagePreview"
                  >
                    <div class="image-placeholder">
                      <i class="bi bi-image"></i>

                      <strong> No image selected </strong>

                      <span> JPG, PNG or WebP </span>
                    </div>
                  </div>

                  <label for="bannerImage" class="image-upload-btn">
                    <i class="bi bi-cloud-arrow-up"></i>

                    Choose Image
                  </label>

                  <input
                    type="file"
                    id="bannerImage"
                    name="image"
                    accept="image/jpeg,image/png,image/webp"
                    hidden
                  />

                  <div class="image-help">
                    Recommended:
                    <strong>1600 × 600px</strong>

                    <br />

                    Maximum file size:
                    <strong>2MB</strong>
                  </div>
                </div>
              </div>

              <!-- ACTIONS -->

              <div class="form-actions">
                <a href="/admin/main-banners" class="cancel-btn"> Cancel </a>

                <button
                  type="submit"
                  class="save-service-btn"
                  id="saveBannerBtn"
                >
                  <i class="bi bi-check-lg"></i>

                  <span id="saveButtonText"> Save Banner </span>
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/main-banner.js"></script>

  </body>
</html>
