<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Metro Cool - Admin Services</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="assets/style.css" />
  </head>

  <body>
    <div class="admin-layout">
      <!-- =========================================
         SIDEBAR
    ========================================== -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-inner">
          <!-- Logo -->
          <div class="brand">
            <div class="brand-icon">
              <i class="bi bi-flower1"></i>
            </div>

            <div class="brand-content">
              <h1>Metro Cool</h1>
              <span>Service Listing</span>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="sidebar-nav">
            <a href="dashboard.html" class="nav-item">
              <i class="bi bi-house-fill"></i>
              <span>Dashboard</span>
            </a>

            <a href="services.html" class="nav-item">
              <i class="bi bi-grid-3x3-gap"></i>
              <span>Services</span>
            </a>

            <a href="banners.html" class="nav-item">
              <i class="bi bi-image"></i>
              <span>Banners</span>
            </a>

            <a href="blogs.html" class="nav-item active">
              <i class="bi bi-file-earmark-text"></i>
              <span>Blogs</span>
            </a>

            <a href="testimonials.html" class="nav-item">
              <i class="bi bi-chat-square-text"></i>
              <span>Testimonials</span>
            </a>
          </nav>

          <!-- Bottom Section -->
          <div class="sidebar-bottom">
            <a href="#" class="logout-link">
              <i class="bi bi-box-arrow-right"></i>
              <span>Logout</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Sidebar overlay for mobile -->
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <!-- =========================================
         MAIN CONTENT
    ========================================== -->
      <main class="main-content">
        <!-- =========================================
         TOP HEADER
    ========================================== -->

        <header class="top-header">
          <div class="header-left">
            <!-- Search -->
            <div class="header-search">
              <input type="text" placeholder="Search anything..." />

              <button type="button">
                <i class="bi bi-search"></i>
              </button>
            </div>
          </div>

          <div class="header-right">
            <!-- User -->
            <div class="header-user">
              <div class="header-user-info">
                <strong>Metro Cool</strong>
                <span>Admin</span>
              </div>

              <div class="header-user-avatar">
                <img src="assets/images/user.jpg" alt="Admin" />
              </div>
            </div>
          </div>
        </header>

        <!-- =========================================
         BLOG CONTENT
    ========================================== -->

        <div class="dashboard-content blogs-page">
          <!-- =====================================
             PAGE HEADER
        ====================================== -->

          <div class="blogs-page-header">
            <div class="page-title-wrapper">
              <h2>Blogs</h2>

              <div class="breadcrumb-custom">
                <a href="index.html"> Dashboard </a>

                <i class="bi bi-chevron-right"></i>

                <span> Blogs </span>
              </div>
            </div>

            <!-- Add Blog -->

            <a href="blog-form.html" class="add-blog-btn">
              <i class="bi bi-plus-lg"></i>

              <span> Add New Blog </span>
            </a>
          </div>

          <!-- =====================================
             FILTER TOOLBAR
        ====================================== -->

          <div class="blogs-toolbar">
            <!-- Filters -->

            <div class="blogs-filters">
              <!-- Search -->

              <div class="blog-search">
                <i class="bi bi-search"></i>

                <input
                  type="text"
                  id="blogSearch"
                  placeholder="Search blogs..."
                />
              </div>

              <!-- Category -->

              <div class="blog-filter-select">
                <select id="blogCategoryFilter">
                  <option value="">All Categories</option>

                  <option value="cleaning">Cleaning</option>

                  <option value="home-repair">Home Repair</option>

                  <option value="pest-control">Pest Control</option>

                  <option value="renovation">Renovation</option>

                  <option value="installation">Installation</option>
                </select>

                <i class="bi bi-chevron-down"></i>
              </div>

              <!-- Status -->

              <div class="blog-filter-select">
                <select id="blogStatusFilter">
                  <option value="">All Status</option>

                  <option value="published">Published</option>

                  <option value="draft">Draft</option>
                </select>

                <i class="bi bi-chevron-down"></i>
              </div>
            </div>
          </div>

          <!-- =====================================
             BLOG TABLE
        ====================================== -->

          <div class="blogs-table-wrapper">
            <table class="blogs-table">
              <thead>
                <tr>
                  <th class="blog-column">BLOG</th>

                  <th>CATEGORY</th>

                  <th>STATUS</th>

                  <th>DATE</th>

                  <th class="actions-column">ACTIONS</th>
                </tr>
              </thead>

              <tbody id="blogsTableBody">
                <!-- =================================
                         BLOG 01
                    ================================== -->

                <tr
                  class="blog-row"
                  data-title="Top 10 Cleaning Tips for Your Home"
                  data-category="cleaning"
                  data-status="published"
                >
                  <td class="blog-info-cell">
                    <div class="blog-thumbnail">
                      <img
                        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRBZDdjtmOTQVP9sFeq2paI2zHrK4mFxv2v86Mw3CH3mnnMFM1s9uF0np0&s=10"
                        alt="Top 10 Cleaning Tips for Your Home"
                      />
                    </div>

                    <div class="blog-title">
                      <span> Top 10 Cleaning Tips for Your Home </span>
                    </div>
                  </td>

                  <td>
                    <span class="blog-category"> Cleaning </span>
                  </td>

                  <td>
                    <span class="blog-status published"> Published </span>
                  </td>

                  <td>
                    <span class="blog-date"> May 18, 2025 </span>
                  </td>

                  <td>
                    <div class="blog-actions">
                      <button
                        type="button"
                        class="blog-action edit"
                        title="Edit blog"
                      >
                        <i class="bi bi-pencil"></i>
                      </button>

                      <button
                        type="button"
                        class="blog-action delete"
                        title="Delete blog"
                      >
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- =================================
                         BLOG 02
                    ================================== -->

                <tr
                  class="blog-row"
                  data-title="How to Maintain Your Plumbing System"
                  data-category="home-repair"
                  data-status="published"
                >
                  <td class="blog-info-cell">
                    <div class="blog-thumbnail">
                      <img
                        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRBZDdjtmOTQVP9sFeq2paI2zHrK4mFxv2v86Mw3CH3mnnMFM1s9uF0np0&s=10"
                        alt="How to Maintain Your Plumbing System"
                      />
                    </div>

                    <div class="blog-title">
                      <span> How to Maintain Your Plumbing System </span>
                    </div>
                  </td>

                  <td>
                    <span class="blog-category"> Home Repair </span>
                  </td>

                  <td>
                    <span class="blog-status published"> Published </span>
                  </td>

                  <td>
                    <span class="blog-date"> May 16, 2025 </span>
                  </td>

                  <td>
                    <div class="blog-actions">
                      <button type="button" class="blog-action edit">
                        <i class="bi bi-pencil"></i>
                      </button>

                      <button type="button" class="blog-action delete">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- =================================
                         BLOG 03
                    ================================== -->

                <tr
                  class="blog-row"
                  data-title="Benefits of Regular Pest Control"
                  data-category="pest-control"
                  data-status="draft"
                >
                  <td class="blog-info-cell">
                    <div class="blog-thumbnail">
                      <img
                        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRBZDdjtmOTQVP9sFeq2paI2zHrK4mFxv2v86Mw3CH3mnnMFM1s9uF0np0&s=10"
                        alt="Benefits of Regular Pest Control"
                      />
                    </div>

                    <div class="blog-title">
                      <span> Benefits of Regular Pest Control </span>
                    </div>
                  </td>

                  <td>
                    <span class="blog-category"> Pest Control </span>
                  </td>

                  <td>
                    <span class="blog-status draft"> Draft </span>
                  </td>

                  <td>
                    <span class="blog-date"> May 15, 2025 </span>
                  </td>

                  <td>
                    <div class="blog-actions">
                      <button type="button" class="blog-action edit">
                        <i class="bi bi-pencil"></i>
                      </button>

                      <button type="button" class="blog-action delete">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- =================================
                         BLOG 04
                    ================================== -->

                <tr
                  class="blog-row"
                  data-title="Choosing the Right Painting Colors"
                  data-category="renovation"
                  data-status="published"
                >
                  <td class="blog-info-cell">
                    <div class="blog-thumbnail">
                      <img
                        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRBZDdjtmOTQVP9sFeq2paI2zHrK4mFxv2v86Mw3CH3mnnMFM1s9uF0np0&s=10"
                        alt="Choosing the Right Painting Colors"
                      />
                    </div>

                    <div class="blog-title">
                      <span> Choosing the Right Painting Colors </span>
                    </div>
                  </td>

                  <td>
                    <span class="blog-category"> Renovation </span>
                  </td>

                  <td>
                    <span class="blog-status published"> Published </span>
                  </td>

                  <td>
                    <span class="blog-date"> May 14, 2025 </span>
                  </td>

                  <td>
                    <div class="blog-actions">
                      <button type="button" class="blog-action edit">
                        <i class="bi bi-pencil"></i>
                      </button>

                      <button type="button" class="blog-action delete">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- =================================
                         BLOG 05
                    ================================== -->

                <tr
                  class="blog-row"
                  data-title="AC Maintenance Tips for Summer"
                  data-category="home-repair"
                  data-status="published"
                >
                  <td class="blog-info-cell">
                    <div class="blog-thumbnail">
                      <img
                        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRBZDdjtmOTQVP9sFeq2paI2zHrK4mFxv2v86Mw3CH3mnnMFM1s9uF0np0&s=10"
                        alt="AC Maintenance Tips for Summer"
                      />
                    </div>

                    <div class="blog-title">
                      <span> AC Maintenance Tips for Summer </span>
                    </div>
                  </td>

                  <td>
                    <span class="blog-category"> Home Repair </span>
                  </td>

                  <td>
                    <span class="blog-status published"> Published </span>
                  </td>

                  <td>
                    <span class="blog-date"> May 12, 2025 </span>
                  </td>

                  <td>
                    <div class="blog-actions">
                      <button type="button" class="blog-action edit">
                        <i class="bi bi-pencil"></i>
                      </button>

                      <button type="button" class="blog-action delete">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- =================================
                         BLOG 06
                    ================================== -->

                <tr
                  class="blog-row"
                  data-title="Safety Tips for Electrical Installation"
                  data-category="installation"
                  data-status="draft"
                >
                  <td class="blog-info-cell">
                    <div class="blog-thumbnail">
                      <img
                        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRBZDdjtmOTQVP9sFeq2paI2zHrK4mFxv2v86Mw3CH3mnnMFM1s9uF0np0&s=10"
                        alt="Safety Tips for Electrical Installation"
                      />
                    </div>

                    <div class="blog-title">
                      <span> Safety Tips for Electrical Installation </span>
                    </div>
                  </td>

                  <td>
                    <span class="blog-category"> Installation </span>
                  </td>

                  <td>
                    <span class="blog-status draft"> Draft </span>
                  </td>

                  <td>
                    <span class="blog-date"> May 10, 2025 </span>
                  </td>

                  <td>
                    <div class="blog-actions">
                      <button type="button" class="blog-action edit">
                        <i class="bi bi-pencil"></i>
                      </button>

                      <button type="button" class="blog-action delete">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- =====================================
             EMPTY STATE
        ====================================== -->

          <div class="blogs-empty" id="blogsEmpty">
            <i class="bi bi-journal-text"></i>

            <h4>No blogs found</h4>

            <p>Try changing your search or filters.</p>
          </div>

          <!-- =====================================
             TABLE FOOTER
        ====================================== -->

          <div class="blogs-footer">
            <div class="blogs-count">
              Showing
              <strong id="visibleBlogCount">1</strong>
              to
              <strong>6</strong>
              of
              <strong>72</strong>
              entries
            </div>

            <!-- Pagination -->

            <div class="blogs-pagination">
              <button type="button" class="pagination-btn disabled">
                <i class="bi bi-chevron-left"></i>
              </button>

              <button type="button" class="pagination-btn active">1</button>

              <button type="button" class="pagination-btn">2</button>

              <button type="button" class="pagination-btn">3</button>

              <span class="pagination-dots"> ... </span>

              <button type="button" class="pagination-btn">12</button>

              <button type="button" class="pagination-btn">
                <i class="bi bi-chevron-right"></i>
              </button>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="assets/main.js"></script>
  </body>
</html>
